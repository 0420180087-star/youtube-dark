# =============================================================================
# DarkStream — variáveis de ambiente
# =============================================================================
# Esses valores devem ser configurados em DOIS lugares diferentes:
#
#   1. Lovable Workspace → Settings → Build Secrets   (preview do Lovable)
#   2. GitHub repo → Settings → Secrets and variables → Actions
#      (build do GitHub Pages + runner do auto-post.yml)
#
# As variáveis VITE_* são embutidas no bundle no momento do build —
# não use valores realmente secretos aqui (chaves OAuth client_secret etc.
# ficam no Supabase Edge Functions e no GitHub Actions, nunca no frontend).
# =============================================================================

# Base path do GitHub Pages, ex: /darkstream-ai/
VITE_BASE_URL=/nome-do-repositorio/

# --- Supabase (frontend) ---
# Pegue em Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (backend / GitHub Actions only) ---
# Service-role key — NUNCA expor no frontend
SUPABASE_SERVICE_KEY=

# --- API keys (opcionais; preferimos as chaves por usuário em user_settings) ---
# Servem como fallback quando o usuário do projeto não cadastrou nenhuma chave.
VITE_GEMINI_API_KEY=
VITE_PEXELS_API_KEY=

# --- Google / YouTube OAuth ---
# Client ID é público (vai no frontend)
VITE_GOOGLE_CLIENT_ID=
# Mesmo Client ID para Edge Functions e GitHub Actions (pode apontar para o mesmo valor)
GOOGLE_CLIENT_ID=
# Client secret — só no Supabase Edge Function secrets e no GitHub Actions
YOUTUBE_CLIENT_SECRET=
# Origem autorizada para as Edge Functions, ex: https://usuario.github.io
ALLOWED_ORIGIN=
